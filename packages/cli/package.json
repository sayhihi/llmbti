{
  "name": "llmbti",
  "version": "0.1.1",
  "description": "LLM에게 일을 시키는 패턴과 셸 히스토리로 보는 개발자 MBTI. 픽셀 캐릭터와 개발 유머 디스로 보여준다.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "llmbti": "dist/index.js"
  },
  "files": [
    "dist",
    "skill",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sayhihi/llmbti.git",
    "directory": "packages/cli"
  },
  "homepage": "https://llmbti.vercel.app",
  "bugs": {
    "url": "https://github.com/sayhihi/llmbti/issues"
  },
  "keywords": [
    "mbti",
    "claude-code",
    "developer",
    "cli",
    "pixel-art",
    "개발자 MBTI"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "preview": "tsx src/dev/preview.ts"
  },
  "devDependencies": {
    "@llmbti/core": "workspace:*",
    "@types/node": "^24.19.2",
    "tsup": "^9.0.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  }
}
